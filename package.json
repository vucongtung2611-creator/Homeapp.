{
  "name": "homeapp",
  "version": "0.1.0",
  "description": "AI Household Butler — a Connected Living Platform built on a Household Graph",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p . && node scripts/build-web.mjs",
    "build:server": "tsc -p .",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc -p . --noEmit && tsc -p web --noEmit",
    "test": "node scripts/check-i18n.mjs && tsc -p . && tsc -p web --noEmit && node --test \"dist/test/**/*.test.js\"",
    "start": "node --disable-warning=ExperimentalWarning dist/server/main.js",
    "dev": "npm run build && PORT=3000 npm start",
    "demo": "tsc -p . && node dist/src/demo.js",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:pg": "tsc -p . && TEST_DB=pglite node --test \"dist/test/server-*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "@tesseract.js-data/vie": "^1.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "preact": "^10.29.8",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "pg": "^8.23.1"
  }
}
